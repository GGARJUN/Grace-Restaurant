# Server port
PORT=4000

# Optional: Google Maps Distance Matrix API key.
# If set, real ROAD distance is used (needs billing enabled on Google Cloud).
# If left empty, the server automatically falls back to free OpenStreetMap
# Nominatim geocoding + straight-line (Haversine) distance — no key needed.
GOOGLE_MAPS_API_KEY=AIzaSyByQ6dmsSRqaNAFgOcm6EYAScEOd_0P7ug

# Required for address autocomplete (server/routes/autocomplete.js and
# server/routes/place-details.js). Get this from Google Cloud Console:
# APIs & Services → enable "Places API (New)" → Credentials → Create API Key.
# Needs a billing account on the Google Cloud project (free $200/month
# credit usually covers small apps) — see console.cloud.google.com/billing.
# Without this set, address autocomplete will silently return no results.
GOOGLE_PLACES_API_KEY=AIzaSyByQ6dmsSRqaNAFgOcm6EYAScEOd_0P7ug

# Optional: Razorpay keys (only needed for the payment route)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
