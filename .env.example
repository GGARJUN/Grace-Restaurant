# Points the frontend at the Express backend in /server.
# Leave this UNSET to use the built-in mock (fake distance) for quick UI dev.
VITE_API_BASE_URL=http://localhost:4000

# Required for the address autocomplete field (src/components/AddressAutocomplete.jsx).
# Get this from Google Cloud Console: enable "Maps JavaScript API" and
# "Places API", then Credentials → Create API Key.
# IMPORTANT: this key is visible in the browser (that's normal for the
# Maps JavaScript API) — you MUST restrict it in Cloud Console →
# Credentials → your key → Application restrictions → "HTTP referrers" →
# add your domain(s), e.g. your-app.vercel.app/* and localhost:5173/* for
# local dev. Without that restriction, anyone can copy it from devtools
# and use it on your bill.
VITES_GOOGLE_MAPS_API_KEY=
